# PostgreSQL / Supabase ulanish satri
DATABASE_URL="postgresql://postgres:parol@localhost:5432/edusokh"

# Claude API kaliti — AI test generatori uchun. Bo'lmasa, tayyor savollar bankidan foydalaniladi.
ANTHROPIC_API_KEY=""

# YouTube Data API v3 kaliti — har mavzuga video topish uchun (npm run lessons:build). Bepul: console.cloud.google.com
YOUTUBE_API_KEY=""

# Faqat ishlab chiqishda: API so'rovlarida "x-demo-user" sarlavhasi orqali foydalanuvchini tanlash.
# Production'da "false" bo'lishi SHART — haqiqiy avtorizatsiya ulanmaguncha API yopiq turadi.
DEMO_AUTH="true"

# Kitob yig'uvchi qayerga saqlaydi (public/ ichida bo'lsa, brauzer orqali ochiladi)
BOOKS_DIR="public/books"
